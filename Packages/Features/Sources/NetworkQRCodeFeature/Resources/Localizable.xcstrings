{
  "sourceLanguage": "en",
  "strings": {
    "network_qrcode_retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
      }
    },
    "network_qrcode_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your QR code or send a link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите QR-код или отправьте ссылку."
          }
        }
      }
    },
    "network_qrcode_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add people"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить друзей"
          }
        }
      }
    },
    "network_qrcode_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share the QR code or link with as many people as you like. Anyone can use the invitation until it expires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-кодом или ссылкой можно поделиться с любым количеством людей. Каждый сможет воспользоваться приглашением, пока оно действует."
          }
        }
      }
    },
    "io_error_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection problem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проблема соединения"
          }
        }
      }
    },
    "io_error_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like we can't reach our servers..."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не можем достучаться до наших серверов…"
          }
        }
      }
    },
