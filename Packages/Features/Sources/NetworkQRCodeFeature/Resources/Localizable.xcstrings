    "network_qrcode_replace_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current QR code and link will stop working immediately. The replacement will be valid for 24 hours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущие QR-код и ссылка сразу перестанут работать. Новый код и новая ссылка будут действовать 24 часа."
          }
        }
      }
    },
